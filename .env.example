# Porta do servidor de desenvolvimento (npm run dev)
PORT=5173

# Nome, banco e cidade do recebedor gravados no QR Code PIX.
# Nome e cidade serão normalizados automaticamente (caixa alta, sem acentos,
# máx. 25/15). O banco é exibido na página no lugar da cidade.
VITE_MERCHANT_NAME=RECEBEDOR
VITE_MERCHANT_BANK=SEU BANCO
VITE_MERCHANT_CITY=SAO PAULO